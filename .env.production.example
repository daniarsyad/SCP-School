APP_NAME="SCP School"
APP_ENV=production
APP_KEY=base64:V3EGCoBHeaLBETdPy0XtPlc19Urt8EWwM8GGzWjl2OQ=
APP_DEBUG=false
APP_URL=https://escepegaul.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=error

# Konfigurasi Database MySQL di cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ganti_dengan_nama_db_cpanel
DB_USERNAME=ganti_dengan_user_db_cpanel
DB_PASSWORD=ganti_dengan_password_db_cpanel

# Driver untuk Shared Hosting (Wajib sync & file karena tidak ada terminal background worker)
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email SMTP cPanel (untuk pengiriman OTP lupa password)
MAIL_MAILER=smtp
MAIL_HOST=mail.escepegaul.web.id
MAIL_PORT=465
MAIL_USERNAME=noreply@escepegaul.web.id
MAIL_PASSWORD=ganti_dengan_password_email_cpanel
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@escepegaul.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# Pengaturan Keamanan Khusus
DEPLOY_SECRET=ganti_dengan_token_rahasia_acak_panjang
ALLOW_REGISTRATION=false

